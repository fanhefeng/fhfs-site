// The media Worker (worker.ts). Deployed with `pnpm media:deploy`, never by
// hand: the script refuses when a file the database points at is missing
// from files/, since a deploy replaces every asset at once.
{
  "name": "fhfs-media",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./files",
    "binding": "ASSETS",
    "run_worker_first": ["/moments/*", "/_uploads/*"],
  },
  "observability": { "enabled": false },
  "kv_namespaces": [{ "binding": "UPLOADS", "id": "175c82b5b1344cef9022466565bbbc84" }],
  "vars": { "UPLOAD_SITE_ORIGIN": "https://fhfs-site.vercel.app" },
  "triggers": { "crons": ["17 * * * *"] },
}
