# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# drizzle-kit's local introspection scratch
/drizzle/.snapshots

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor settings stay per-machine
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local-only notes: anything named *.local.md stays on this machine
*.local.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Half-written snapshot from a db:export that failed partway.
.backup.staging/

# Claude Code's per-machine state. This machine also lists the runtime files
# in .git/info/exclude (Claude Code writes them there), but that file is not
# cloned: a fresh checkout — a cloud session, another machine — would offer
# them for commit. A list rather than `.claude/`, so project-wide settings
# (.claude/settings.json, skills, agents) stay committable.
.claude/settings.local.json
.claude/RESUME.md
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
