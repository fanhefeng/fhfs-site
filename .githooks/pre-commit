#!/bin/sh
# Installed by `pnpm install` (package.json "prepare" points core.hooksPath
# here). Fast on purpose — the full gate is pre-push; this only does what is
# cheap and what people forget.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -z "$staged" ] && exit 0

# A file changed in public/ means the hash manifest (and the font stylesheet's
# addresses) changed with it. Regenerate and carry them in the same commit,
# rather than letting CI say so ten minutes later.
if printf '%s\n' "$staged" | grep -q '^public/'; then
  pnpm -s assets >/dev/null
  git add src/lib/assets.gen.json src/app/yozai.css
fi

# Format and lint what is being committed, not the tree. A check, not a
# rewrite: a hook that edits files under a commit in progress is a surprise.
formatted=$(printf '%s\n' "$staged" | while read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done)
if [ -n "$formatted" ]; then
  # shellcheck disable=SC2086
  pnpm -s exec prettier --check --ignore-unknown $formatted || {
    echo "pre-commit: run \`pnpm format\` and stage the result." >&2
    exit 1
  }
fi

files=$(printf '%s\n' "$staged" | grep -E '\.(m?ts|tsx)$' | while read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done)
if [ -n "$files" ]; then
  # shellcheck disable=SC2086
  pnpm -s exec oxlint -c .oxlintrc.json $files
fi
