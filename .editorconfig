root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# A trailing double space is a line break there.
[*.md]
trim_trailing_whitespace = false

# Applied by pnpm as written; an editor "fixing" whitespace breaks the hunks.
[patches/**]
trim_trailing_whitespace = false
insert_final_newline = false
