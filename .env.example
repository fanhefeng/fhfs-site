# Copy to .env.local, or pull the real values: `vercel env pull .env.local`.
# The rules each value must meet are in src/lib/env.ts; a production build or
# server refuses to start when one fails. env.test.ts keeps this file and that
# list naming the same variables.

# Neon Postgres, the pooled connection string. Required at build time too:
# pages are prerendered from the database.
DATABASE_URL=

# Optional. Neon's direct (unpooled) string; the scripts under scripts/ and
# drizzle-kit prefer it when set.
DATABASE_URL_UNPOOLED=

# Both printed by `pnpm admin:password`. The hash is `salt:hash` from scrypt;
# the password itself is stored nowhere.
AUTH_SECRET=
ADMIN_PASSWORD_HASH=

# Optional. The production origin for canonical URLs, the sitemap and RSS, e.g.
# https://example.com. On Vercel it is read from the project's production
# domain by itself; set this only to override that, or when hosting elsewhere.
SITE_URL=

# Optional. The Blob store fhfs-media's read-write token (vercel_blob_rw_…).
# Vercel sets it on the project once the store is connected; the admin's
# upload buttons sign their uploads with it (src/app/admin/upload/route.ts)
# and say so when it is missing.
BLOB_READ_WRITE_TOKEN=

# Optional. Only lifts GitHub's rate limit for the release lookups behind the
# app version badges (src/lib/github.ts); without it they still work.
GITHUB_TOKEN=
